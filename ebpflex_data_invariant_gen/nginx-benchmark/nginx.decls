decl-version 2.0
var-comparability implicit

ppt SimpleNginx.checkAlloc(int):::ENTER
  ppt-type enter
  variable size
    var-kind variable
    rep-type int
    dec-type int
    comparability 1

ppt SimpleNginx.checkAlloc(int):::EXIT
  ppt-type exit
  variable size
    var-kind variable
    rep-type int
    dec-type int
    comparability 1
  variable return
    var-kind return
    rep-type int
    dec-type int
    comparability 2

ppt SimpleNginx.checkStatus(int):::ENTER
  ppt-type enter
  variable status
    var-kind variable
    rep-type int
    dec-type int
    comparability 1

ppt SimpleNginx.checkStatus(int):::EXIT
  ppt-type exit
  variable status
    var-kind variable
    rep-type int
    dec-type int
    comparability 1
  variable return
    var-kind return
    rep-type int
    dec-type int
    comparability 2
