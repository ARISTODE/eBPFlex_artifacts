decl-version 2.0
var-comparability implicit

ppt SimpleNginx.checkAlloc(int):::ENTER
  ppt-type enter
  variable size
    var-kind variable
    rep-type int
    dec-type int
    comparability 1

ppt SimpleNginx.checkAlloc(int):::EXIT1
